{
  "name": "imap-wizard",
  "version": "0.3.2",
  "mcpName": "io.github.Fe2-O3/imap-wizard",
  "description": "IMAP Wizard — email MCP server with IMAP + SMTP support",
  "type": "module",
  "bin": {
    "imap-wizard": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "COPYING",
    "NOTICE"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "smoke": "tsx scripts/e2e-smoke.mts",
    "test:all": "vitest run && vitest run --config vitest.config.integration.ts",
    "check": "biome check src/",
    "report": "mkdir -p reports && biome check src/ --reporter=json > reports/biome.json 2>&1; actionlint -format '{{json .}}' > reports/actionlint.json 2>&1; pnpm test",
    "commit": "cog commit",
    "changelog": "cog changelog",
    "version:check": "cog check",
    "version:bump": "cog bump --auto",
    "version:bump:minor": "cog bump --minor",
    "version:bump:patch": "cog bump --patch",
    "version:log": "cog log",
    "prepare": "(test -f dist/main.js || tsc -p tsconfig.build.json) && (lefthook install || true)",
    "hooks:install": "lefthook install --force",
    "hooks:uninstall": "lefthook uninstall",
    "docker:build": "docker build -t imap-wizard .",
    "docker:run": "docker run --rm -i -v ~/.config/email-mcp:/home/node/.config/email-mcp:ro imap-wizard",
    "docker:compose": "docker compose up",
    "docker:clean": "docker images --format '{{.Repository}}:{{.Tag}}' | grep imap-wizard | xargs docker rmi -f 2>/dev/null; true",
    "docker:prune": "docker image prune -f && docker buildx prune -f",
    "release:check": "goreleaser check",
    "release:snapshot": "goreleaser release --snapshot --clean && pnpm docker:clean",
    "release:dry-run": "goreleaser release --skip=publish --clean && pnpm docker:clean",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "email",
    "mcp",
    "imap",
    "smtp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "anthropic",
    "ai-tools",
    "llm",
    "nodejs"
  ],
  "author": {
    "name": "Fe2-O3",
    "url": "https://github.com/Fe2-O3"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fe2-O3/imap-wizard.git"
  },
  "homepage": "https://github.com/Fe2-O3/imap-wizard#readme",
  "bugs": {
    "url": "https://github.com/Fe2-O3/imap-wizard/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "imapflow": "^2.12.1",
    "node-ical": "^0.27.6",
    "nodemailer": "^10.6.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "lefthook": "^2.2.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public"
  }
}
